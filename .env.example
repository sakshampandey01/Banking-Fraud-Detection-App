# Copy to .env (cp .env.example .env) and edit. Never commit .env.
#
# PostgreSQL connection. Homebrew's PostgreSQL uses your macOS user name and no password:
DATABASE_URL=postgresql+psycopg://localhost:5432/fraud_db
# With a password:  postgresql+psycopg://USER:PASSWORD@localhost:5432/fraud_db
# (if the password contains @ : / # ? use %40 %3A %2F %23 %3F)

# Model artifacts (relative paths are inside the project folder). If MODEL_PATH does not exist the app
# also looks for best_fraud_model_tuned.pkl in the project root.
MODEL_PATH=models/best_fraud_model_tuned.pkl
PREPROCESSING_PATH=models/preprocessing.json

# probability >= the model's own threshold (stored in the .pkl) => HIGH (blocked)
# probability >= MEDIUM_RISK_THRESHOLD                          => MEDIUM (approved, flagged)
MEDIUM_RISK_THRESHOLD=0.5

# Allowed browser origins, JSON list
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
